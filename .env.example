# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# --- LLM ---
# Provider: "anthropic" (default) or "openrouter" (OpenAI-compatible gateway for cheap open models).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter (used when LLM_PROVIDER=openrouter). Authenticated via Authorization: Bearer.
# NOTE: requires the Authorization header to reach openrouter.ai — some egress proxies strip it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cost-aware model routing (override defaults if desired)
MODEL_SYNTHESIS=claude-opus-4-8        # Stages 3, 5, 7 — deep reasoning
MODEL_SCREEN=claude-haiku-4-5-20251001 # Stage 1 — bulk universe screening
MODEL_ANALYSIS=claude-sonnet-4-6       # Stages 2, 4, 6 — mid-depth analysis

# --- Data: Finviz — Stage-1 screening (no key required) ---
# The universe + quant fundamentals are sourced from Finviz's public screener (https://finviz.com),
# because FMP deprecated its legacy screener and gates the new one behind a paid plan.

# --- Data: FMP (Financial Modeling Prep) — per-symbol fundamentals (Stages 2+) ---
# Fundamentals, prices, earnings. https://site.financialmodelingprep.com/
# Free keys: the new "/stable" base works per-symbol; the screener needs a paid plan.
FMP_API_KEY=
# Override only if your key targets FMP's newer "/stable" base instead of legacy "/api/v3".
# FMP_BASE_URL=https://financialmodelingprep.com/api/v3

# --- Data: Bigdata.com — unstructured edge (news/sentiment/events/filings/transcripts) ---
# Connected via MCP in the orchestrator; key here only if calling the REST API directly.
BIGDATA_API_KEY=

# --- Optional free redundancy ---
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- Fallback primary feed (if FMP small/mid-cap coverage proves insufficient) ---
FINANCIAL_DATASETS_API_KEY=

# --- Run config ---
PORTFOLIO_CAPITAL_USD=10000
LOG_LEVEL=INFO
