# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Cost-aware model routing (override defaults if desired)
MODEL_SYNTHESIS=claude-opus-4-8        # Stages 3, 5, 7 — deep reasoning
MODEL_SCREEN=claude-haiku-4-5-20251001 # Stage 1 — bulk universe screening
MODEL_ANALYSIS=claude-sonnet-4-6       # Stages 2, 4, 6 — mid-depth analysis

# --- Data: FMP (Financial Modeling Prep) — primary feed ---
# Fundamentals, prices, earnings, stock screener. https://site.financialmodelingprep.com/
FMP_API_KEY=
# Override only if your key targets FMP's newer "/stable" base instead of legacy "/api/v3".
# FMP_BASE_URL=https://financialmodelingprep.com/api/v3

# --- Data: Bigdata.com — unstructured edge (news/sentiment/events/filings/transcripts) ---
# Connected via MCP in the orchestrator; key here only if calling the REST API directly.
BIGDATA_API_KEY=

# --- Optional free redundancy ---
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- Fallback primary feed (if FMP small/mid-cap coverage proves insufficient) ---
FINANCIAL_DATASETS_API_KEY=

# --- Run config ---
PORTFOLIO_CAPITAL_USD=10000
LOG_LEVEL=INFO
